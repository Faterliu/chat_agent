+    allowed_dm = {"qa_dm_old", "qa_g1_old", "qa_g1_now", "qa_g2"}
+    allowed_group = {"qa_g1_old"}
+    for sid, principal, allowed in (("qa_dm_now", dm, allowed_dm),
+                                    ("qa_g1_now", group, allowed_group)):
