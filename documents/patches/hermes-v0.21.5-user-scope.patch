--- /dev/null
+++ b/tools/gateway_user_scope.py
@@ -0,0 +1,67 @@
+"""Trusted QQ/Weixin identity for built-in memory and conversation recall."""
+
+from dataclasses import dataclass
+from hashlib import sha256
+from pathlib import Path
+
+from hermes_constants import get_hermes_home
+
+
+MESSAGE_PLATFORMS = frozenset({"qqbot", "weixin"})
+
+
+@dataclass(frozen=True)
+class GatewayUserScope:
+    platform: str
+    user_id: str
+    chat_type: str
+    chat_id: str
+
+    @property
+    def memory_kind(self) -> str:
+        return "groups" if self.chat_type == "group" else "private"
+
+    def memory_dir(self, kind: str = None) -> Path:
+        if kind not in (None, "private", "groups"):
+            raise ValueError("invalid memory kind")
+        digest = sha256(f"{self.platform}\0{self.user_id}".encode("utf-8")).hexdigest()
+        return get_hermes_home() / "memories" / "users" / self.platform / digest / (kind or self.memory_kind)
+
+    def memory_revision(self) -> tuple:
+        """Detect another chat's write before reusing a frozen prompt snapshot."""
+        directory = self.memory_dir()
+        revision = []
+        for name in ("USER.md", "MEMORY.md"):
+            try:
+                stat = (directory / name).stat()
+                revision.append((stat.st_mtime_ns, stat.st_size))
+            except FileNotFoundError:
+                revision.append(None)
+        return tuple(revision)
+
+    def search_filters(self) -> dict:
+        result = {"source_filter": [self.platform], "user_id_filter": self.user_id}
+        if self.chat_type == "group":
+            result.update(chat_type_filter="group", chat_id_filter=self.chat_id)
+        return result
+
+    def owns(self, row) -> bool:
+        if not row or row.get("source") != self.platform or row.get("user_id") != self.user_id:
+            return False
+        return self.chat_type != "group" or (row.get("chat_type") == "group" and row.get("chat_id") == self.chat_id)
+
+
+def resolve_gateway_scope(db, session_id, platform, user_id, chat_type, chat_id):
+    """Require a durable session row matching the gateway-supplied identity."""
+    if platform not in MESSAGE_PLATFORMS:
+        return None
+    if not all(isinstance(x, str) and x.strip() for x in (session_id, user_id, chat_type, chat_id)):
+        return None
+    if chat_type not in ("dm", "group") or db is None:
+        return None
+    try:
+        row = db.get_session(session_id)
+    except Exception:
+        return None
+    scope = GatewayUserScope(platform, user_id, chat_type, chat_id)
+    return scope if (scope.owns(row) and row.get("chat_type") == chat_type and row.get("chat_id") == chat_id) else None
