+def test_new_compression_and_chinese_like_fallback(corpus):
+    db = corpus
+    db.end_session("qa_g1_old", "compression")
+    db.create_session("qa_g1_cont", source="qqbot", user_id="A", chat_type="group",
+                      chat_id="G1", parent_session_id="qa_g1_old")
+    db.append_message("qa_g1_cont", role="user", content="苹果隔离 continuation")
+    group = scope(db, "qa_g1_cont", typ="group", chat="G1")
+    assert group is not None
+    # The archived compression parent remains recallable from the continuation.
+    result = run_search(db, "qa_g1_cont", group, query="苹果隔离", limit=10)
+    assert "qa_g1_old" in {r["session_id"] for r in result["results"]}
+    db._fts_stale = True
+    fallback = run_search(db, "qa_g1_now", scope(db, "qa_g1_now", typ="group", chat="G1"),
+                          query="苹果隔离", limit=10)
+    assert fallback["success"]
+    fallback_ids = {r["session_id"] for r in fallback["results"]}
+    assert fallback_ids & {"qa_g1_old", "qa_g1_cont"}  # one result per compression lineage
+    assert "qb_g1" not in fallback_ids
