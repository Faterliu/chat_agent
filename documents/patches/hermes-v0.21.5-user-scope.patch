+            result = run_search(db, sid, principal, **kwargs)
+            assert result["success"], result
+            assert {r["session_id"] for r in result["results"]} <= allowed
+            assert "qa_g1_old" in {r["session_id"] for r in result["results"]}
+        for target in ("qb_dm", "qb_g1", "wx_dm", "qa_g2" if principal == group else "qb_g1"):
