+def test_pending_approval_is_bound_to_memory_directory(corpus):
+    db = corpus
+    a = scope(db, "qa_dm_now").memory_dir()
+    b = scope(db, "qb_dm", uid="B", chat="B").memory_dir()
+    rec = wa.stage_write(wa.MEMORY, {"action": "add", "target": "memory", "content": "A"},
+                         summary="A", origin="foreground", memory_dir=a)
+    assert wa.get_pending(wa.MEMORY, rec["id"], memory_dir=a)
+    assert not wa.get_pending(wa.MEMORY, rec["id"], memory_dir=b)
+    assert not wa.list_pending(wa.MEMORY, memory_dir=b)
+    assert not wa.discard_pending(wa.MEMORY, rec["id"], memory_dir=b)
+    assert wa.discard_pending(wa.MEMORY, rec["id"], memory_dir=a)
