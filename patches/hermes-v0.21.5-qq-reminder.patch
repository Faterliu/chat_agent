+"""提醒权限、持久化和正文执行边界；不调用真实提供方。"""
+
+from datetime import datetime, timedelta, timezone
+import json
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from tools.gateway_user_scope import GatewayUserScope
+
+
+@pytest.fixture
+def store(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    from cron import jobs, scheduler
+    monkeypatch.setattr(jobs, "CRON_DIR", tmp_path / "cron")
+    monkeypatch.setattr(jobs, "JOBS_FILE", tmp_path / "cron/jobs.json")
+    monkeypatch.setattr(jobs, "OUTPUT_DIR", tmp_path / "cron/output")
+    monkeypatch.setattr(scheduler, "create_job_with_scheduler_registration", jobs.create_job)
+    monkeypatch.setattr("tools.cronjob_tools._notify_provider_jobs_changed_safe", lambda: None)
+    return jobs, tmp_path
+
+
+def call(uid="A", **args):
+    from tools.qq_reminder import qq_reminder
+    return json.loads(qq_reminder(GatewayUserScope("qqbot", uid, "dm", uid), args))
+
+
+def create(uid="A", text="喝水", **extra):
+    return call(uid, action="create", prompt=text, schedule="in 2m", **extra)
+
+
+def test_owner_list_cancel_and_persistence(store):
+    jobs, home = store
+    a, b = create(), create("B", "B 的提醒")
+    assert a["success"] and b["success"]
+    assert call(action="list")["count"] == 1
+    assert not call("B", action="remove", job_id=a["job_id"])["success"]
+    assert jobs.get_job(a["job_id"])
+    persisted = jobs.get_job(a["job_id"])
+    assert persisted["no_agent"] and persisted["repeat"]["times"] == 1
+    assert persisted["deliver"] == "qqbot:A"
+    assert not persisted["context_from"] and not persisted["attach_to_session"]
+    path = home / "scripts" / persisted["script"]
+    assert path.exists()
+    assert call(action="remove", job_id=a["job_id"])["success"]
+    assert not path.exists() and jobs.get_job(b["job_id"])
+    assert call(action="list")["count"] == 0
+
+
+@pytest.mark.parametrize("scope", [None, GatewayUserScope("qqbot", "A", "group", "G"),
+                                 GatewayUserScope("weixin", "A", "dm", "A")])
+def test_missing_group_and_platform_identity_denied(store, scope):
+    from tools.qq_reminder import qq_reminder
+    assert not json.loads(qq_reminder(scope, {"action": "list"}))["success"]
+
+
+@pytest.mark.parametrize("extra", [{"deliver": "qqbot:B"}, {"script": "/etc/passwd"},
+                                 {"skills": ["terminal"]}, {"context_from": "other"},
+                                 {"enabled_toolsets": ["terminal"]}, {"repeat": 2},
+                                 {"no_agent": False}, {"monitor": "https://example.com"}])
+def test_cannot_widen_capabilities(store, extra):
+    assert not create(**extra)["success"]
+    assert store[0].list_jobs(include_disabled=True) == []
+
+
+@pytest.mark.parametrize("schedule", ["every 1m", "in 0m", "in 31d", "2020-01-01T00:00:00+08:00"])
+def test_schedule_boundaries(store, schedule):
+    assert not call(action="create", prompt="喝水", schedule=schedule)["success"]
+
+
+def test_bare_duration_and_beijing_absolute_time(store):
+    r = call(action="create", prompt="喝水", schedule="2m")
+    assert r["success"]
+    when = datetime.now(timezone(timedelta(hours=8))) + timedelta(hours=2)
+    r = call(action="create", prompt="喝水", schedule=when.replace(tzinfo=None).isoformat())
+    assert r["success"] and datetime.fromisoformat(r["next_run_at"]).utcoffset() == timedelta(hours=8)
+
+
+def test_prompt_is_literal_data_and_no_model_execution(store):
+    text = "喝水\n'); __import__('pathlib').Path('BAD').touch(); #\n$(touch BAD)"
+    r = create(text=text)
+    assert r["success"]
+    job = store[0].get_job(r["job_id"])
+    script = store[1] / "scripts" / job["script"]
+    result = subprocess.run([sys.executable, str(script)], cwd=store[1],
+                            capture_output=True, text=True, encoding="utf-8", check=True)
+    assert result.stdout.strip() == "提醒：" + text
+    assert not (store[1] / "BAD").exists()
+    # 调度器实际 no_agent 执行路径，不创建 Agent 或读取用户记忆。
+    from cron.scheduler import run_job
+    outcome = run_job(job)
+    assert outcome[0] is True and outcome[2] == "提醒：" + text
+
+
+def test_user_cap_and_remove_releases_slot(store, monkeypatch):
+    monkeypatch.setattr("tools.qq_reminder.MAX_REMINDERS", 2)
+    a, b = create(), create()
+    assert not create()["success"]
+    assert create("B")["success"]
+    assert call(action="remove", job_id=a["job_id"])["success"]
+    assert create()["success"]
+
+
+def test_unknown_and_admin_jobs_are_hidden(store):
+    store[0].create_job(prompt="管理员秘密", schedule="in 2m", name="秘密")
+    assert call(action="list")["count"] == 0
+    assert not call(action="remove", job_id="秘密")["success"]
+    assert not call(action="run", job_id="秘密")["success"]
+
+
+@pytest.mark.parametrize("text", ["MEDIA:/etc/passwd", "提醒\n[SILENT]", "[[audio_as_voice]]"])
+def test_reminder_cannot_load_attachments_or_suppress_delivery(store, text):
+    assert not create(text=text)["success"]
+
+
+def test_failed_registration_does_not_leave_live_job(store, monkeypatch):
+    from cron import scheduler
+    def fail(**kw):
+        store[0].create_job(**kw)
+        raise RuntimeError("registration failed")
+    monkeypatch.setattr(scheduler, "create_job_with_scheduler_registration", fail)
+    assert not create()["success"]
+    assert store[0].list_jobs(include_disabled=True) == []
+    assert not list((store[1] / "scripts/qq_reminders").glob("*.py"))
+
+
+def test_inline_rechecks_session_identity(store, monkeypatch):
+    from agent.inline_tool_executors import INLINE_TOOL_EXECUTORS, InlineToolContext, _cronjob
+    from hermes_state import SessionDB
+    db = SessionDB(db_path=store[1] / "state.db")
+    db.create_session("a", source="qqbot", user_id="A", chat_type="dm", chat_id="A")
+    agent = SimpleNamespace(platform="qqbot", session_id="a", _session_db=db,
+                            _user_id="B", _chat_type="dm", _chat_id="A")
+    assert INLINE_TOOL_EXECUTORS["cronjob_manage"] is _cronjob
+    assert not json.loads(_cronjob(agent, {"action": "list"}, InlineToolContext("t")))["success"]
+    agent._user_id = "A"
+    assert json.loads(_cronjob(agent, {"action": "list"}, InlineToolContext("t")))["success"]
+    db.close()
+
+
+def test_schema_and_registry_bypass(store, monkeypatch):
+    import tools.cronjob_tools as tools
+    monkeypatch.setattr(tools, "get_session_env", lambda name, *a: "qqbot" if name == "HERMES_SESSION_PLATFORM" else "")
+    schema = tools._cronjob_schema_overrides()
+    assert "script" not in schema["parameters"]["properties"]
+    assert not json.loads(tools._cronjob_handler({"action": "list"}))["success"]
