
# =============================================================================
# Runtime package mirror (Phase 5, 2026-09-29)
# Hermes lazily installs some optional dependencies at runtime (observed:
# boto3 for the bedrock feature). Without these, uv defaults to pypi.org,
# which is effectively unreachable from this host -- it retried 3 times over
# 84.2 s inside a single turn and stalled `hermes -z` past a 300 s timeout.
# With the mirror set, the same command completes in 35 s.
# =============================================================================
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
